{
  "name": "devin-verification-e2e",
  "version": "1.0.0",
  "description": "E2E integration tests for devin-verification project",
  "private": true,
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:iphone": "playwright test tests/e2e/product-category/iphone/",
    "test:e2e:android": "playwright test tests/e2e/product-category/android/",
    "test:e2e:integration": "playwright test tests/e2e/integration/",
    "test:e2e:report": "playwright show-report",
    "playwright:install": "playwright install --with-deps"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^20",
    "typescript": "^5"
  }
}
